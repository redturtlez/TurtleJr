generator client {
    provider = "prisma-client-js"
    previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  relationMode = "prisma"
}

model Todo{
    userid String @default("turtle") @unique
    todos Json?

    @@index([userid])
}

model Budget{
    userid String @default("turtle") @unique
    budgetItems Json?

    @@index([userid])
}